#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_HOTKEY DIALOGEX 0, 0, 280, 112
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Set grayscale shortcut"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Press a shortcut below. F12 is reserved by Windows.", -1, 12, 12, 256, 20
    CONTROL "", IDC_HOTKEY, HOTKEY_CLASS, WS_TABSTOP | WS_BORDER, 12, 36, 256, 18
    CONTROL "Include Windows key", IDC_WIN_KEY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 62, 180, 12
    DEFPUSHBUTTON "Save", IDOK, 158, 88, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 216, 88, 52, 16
END

IDD_TARGETS DIALOGEX 0, 0, 330, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Target applications"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "One executable name per line (for example, CLIPStudioPaint.exe).", -1, 12, 10, 306, 22
    EDITTEXT IDC_TARGET_LIST, 12, 34, 306, 118, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_PROCESS_LIST, 12, 160, 244, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Add", IDC_ADD_PROCESS, 264, 160, 54, 16
    LTEXT "An empty list disables automatic target matching.", -1, 12, 185, 306, 12
    DEFPUSHBUTTON "Save", IDOK, 208, 206, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 266, 206, 52, 16
END

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CSP Grayscale Viewer\0"
            VALUE "FileVersion", "1.1.0\0"
            VALUE "ProductName", "CSP Grayscale Viewer\0"
            VALUE "ProductVersion", "1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
